MONEYFLOW_PRIMARY.ENV="local"

MONEYFLOW_SERVER.PORT="8080"
MONEYFLOW_SERVER.READ_TIMEOUT="30"
MONEYFLOW_SERVER.WRITE_TIMEOUT="30"
MONEYFLOW_SERVER.IDLE_TIMEOUT="60"
MONEYFLOW_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

MONEYFLOW_DATABASE.HOST="localhost"
MONEYFLOW_DATABASE.PORT="5432"
MONEYFLOW_DATABASE.USER="postgres"
MONEYFLOW_DATABASE.PASSWORD=""
MONEYFLOW_DATABASE.NAME="moneyflow"
MONEYFLOW_DATABASE.SSL_MODE="disable"
MONEYFLOW_DATABASE.MAX_OPEN_CONNS="25"
MONEYFLOW_DATABASE.MAX_IDLE_CONNS="25"
MONEYFLOW_DATABASE.CONN_MAX_LIFETIME="300"
MONEYFLOW_DATABASE.CONN_MAX_IDLE_TIME="300"

MONEYFLOW_AUTH.SECRET_KEY="secret"

MONEYFLOW_INTEGRATION.RESEND_API_KEY="resend_key"

MONEYFLOW_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
MONEYFLOW_OBSERVABILITY.SERVICE_NAME="moneyflow"
MONEYFLOW_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
MONEYFLOW_OBSERVABILITY.LOGGING.LEVEL="debug"
MONEYFLOW_OBSERVABILITY.LOGGING.FORMAT="console"
MONEYFLOW_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
MONEYFLOW_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MONEYFLOW_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
MONEYFLOW_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
MONEYFLOW_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
MONEYFLOW_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
MONEYFLOW_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
MONEYFLOW_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
MONEYFLOW_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"