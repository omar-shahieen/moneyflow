# MoneyFlow Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Clerk publishable key (required)
# Get this from your Clerk dashboard > API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# API base URL (defaults to http://localhost:8080)
VITE_API_URL=http://localhost:8080

# Environment mode: "production" | "development" | "local"
VITE_ENV=local
