# Version control
.git
.gitignore

# Dependencies (re-installed in image)
node_modules
**/node_modules

# Build outputs (rebuilt in image)
dist
**/dist
build
**/build

# Go build cache and artifacts
**/*.test
**/*.out
**/tmp/

# Nx cache
.nx

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Editor / IDE
.vscode
.idea
*.swp
*.swo
*.DS_Store

# Docs and planning (not needed in runtime)
implementation-plan/
README.md
**/*.md
CHANGELOG.md
LICENSE

# Test files
**/*_test.go
**/testdata/
**/__tests__/
**/*.spec.*
**/*.test.*

# CI artifacts
coverage/
*.prof
*.coverprofile

# Docker files themselves (not needed inside image)
Dockerfile*
.dockerignore
docker-compose*
